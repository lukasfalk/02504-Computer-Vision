   "source": [
    "import numpy as np\n",
    "\n",
    "def gaussian1DKernel(sigma):\n",
    "    radius = int(np.ceil(3 * sigma))\n",
    "    x = np.arange(-radius, radius+1)\n",
    "    g = np.exp(-0.5 * (x / sigma)**2) * 1/(np.sqrt(2*np.pi*sigma**2))\n",
    "    gd = -x * g / (sigma**2)\n",
    "    return g, gd"
   ]
  }
